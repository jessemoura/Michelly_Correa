# ==============================================================================
# MICHELLY CORREA — CONFIGURAÇÃO DO SERVIDOR (.htaccess)
# Hospedagem: Hostinger (LiteSpeed / Apache)
# ==============================================================================

# 1. REDIRECIONAMENTOS CANÔNICOS DE DOMÍNIO E PROTOCOLO (SEO)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forçar HTTPS e WWW em regra unificada (sem loops ou múltiplos saltos 301)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^michellycorrea\.com$ [NC]
    RewriteRule ^(.*)$ https://www.michellycorrea.com/$1 [L,R=301]
</IfModule>

# 2. PÁGINA DE ERRO 404 PERSONALIZADA
ErrorDocument 404 /404.html

# 3. CABEÇALHOS DE SEGURANÇA HTTP
<IfModule mod_headers.c>
    # Previne MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Proteção contra Clickjacking (permite apenas no mesmo domínio)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Política de Referrer segura para preservação de privacidade
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Restrição de permissões de hardware para APIs sensíveis
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    
    # Forçar HTTPS via HSTS por 1 ano com suporte a subdomínios e preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# 4. COMPRESSÃO GZIP / DEFLATE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. CACHE DE NAVEGADOR (Core Web Vitals & Performance)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Padrão: 1 mês
    ExpiresDefault "access plus 1 month"
    
    # HTML: sempre validar atualizações
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS e JavaScript: 1 ano (com cache busting de versão)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Imagens e Mídia
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    
    # Fontes Web
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Feeds e Sitemaps
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
</IfModule>
